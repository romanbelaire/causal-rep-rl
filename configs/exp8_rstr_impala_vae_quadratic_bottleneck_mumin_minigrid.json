{
  "experiment": {
    "name": "rstr_impala_vae_quadratic_bottleneck_mumin_minigrid",
    "seed": 42,
    "device": "cuda"
  },
  "environment": {
    "name": "minigrid",
    "task": "MiniGrid-Unlock-v0"
  },
  "architecture": {
    "critic": {
      "type": "vae",
      "latent_dim": 8,
      "encoder_hidden": [64, 64],
      "decoder_hidden": [64, 64],
      "value_head_type": "quadratic_bottleneck_mumin",
      "value_mlp_hidden": 64,
      "value_bottleneck_dim": 8,
      "value_mu_min_floor": 0.02,
      "value_hidden": [],
      "activation": "relu",
      "beta": 1.0
    },
    "policy": {
      "type": "impala",
      "hidden_sizes": [64, 64],
      "activation": "relu",
      "num_residual_blocks": 2
    }
  },
  "algorithm": {
    "type": "ppo",
    "learning_rate": 1e-4,
    "value_coef": 0.5,
    "entropy_coef": 0.01,
    "vae_coef": 0.1,
    "representation_loss_coef": 0.1,
    "representation_loss_coef_warmup_epochs": 400,
    "use_convexity_weighting": true,
    "convexity_coef": 5.0,
    "hessian_compute_freq": 2,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "max_grad_norm": 0.5,
    "num_epochs": 4,
    "num_minibatches": 4,
    "total_timesteps": 1000000
  },
  "metrics": {
    "metric_evaluation_frequency": 10,
    "collect_hessian": true,
    "collect_convexity_validation": true,
    "convexity_mu_min": 0.02,
    "collect_fisher": false,
    "collect_causal_error": false,
    "collect_regret": true,
    "collect_occupancy": false,
    "collect_gradients": true,
    "collect_vae_proxy": true
  }
}
