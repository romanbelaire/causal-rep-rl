{
  "experiment": {
    "name": "expert_vae_minigrid",
    "seed": 42,
    "device": "cuda"
  },
  "environment": {
    "name": "minigrid",
    "task": "MiniGrid-Unlock-v0"
  },
  "architecture": {
    "critic": {
      "type": "vae",
      "latent_dim": 8,
      "encoder_hidden": [64, 64],
      "decoder_hidden": [64, 64],
      "value_hidden": [64, 64],
      "activation": "relu",
      "beta": 1.0
    },
    "policy": {
      "type": "impala",
      "hidden_sizes": [64, 64],
      "activation": "relu",
      "num_residual_blocks": 2
    }
  },
  "algorithm": {
    "type": "ppo",
    "learning_rate": 1e-4,
    "value_coef": 0.5,
    "entropy_coef": 0.01,
    "vae_coef": 0.1,
    "representation_loss_coef": 0.0,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_epsilon": 0.2,
    "max_grad_norm": 0.2,
    "batch_size": 256,
    "num_epochs": 3
  },
  "training": {
    "buffer_size": 4096,
    "total_epochs": 1500,
    "total_steps": null,
    "checkpoint_frequency": 250,
    "eval_frequency": 50,
    "metric_evaluation_frequency": 100,
    "eval_episodes": 100,
    "eval_deterministic": true
  },
  "expert": {
    "min_success_rate": 0.95,
    "stop_when_ready": true
  },
  "metrics": {
    "collect_kl": false,
    "collect_gradients": false,
    "collect_hessian": false,
    "collect_convexity_validation": false,
    "collect_theory_validation": false
  },
  "logging": {
    "log_dir": "./outputs/theory_validation_v2",
    "save_weights": true
  }
}
